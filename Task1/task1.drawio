        </mxCell>
        <mxCell id="n650" value="Потеря данных о клиентах, бронированиях и онлайн-сделках может нарушить процессы продажи недвижимости" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#172033;fontSize=17;fontFamily=Helvetica;spacing=12;arcSize=10;" vertex="1" parent="1">
