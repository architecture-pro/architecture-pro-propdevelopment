  <diagram id="page4" name="Секретные">
    <mxGraphModel grid="1" gridSize="10" page="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n679" value="PropDevelopment · Безопасность данных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172033;fontSize=17;fontFamily=Helvetica;spacing=12;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1990" height="65" />
        </mxCell>
        <mxCell id="n680" value="Категория → Тип данных → Риск и оценка → Обоснование&lt;br&gt;Цвет ветки обозначает категорию; цвет подписи оценки — серьёзность риска." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172033;fontSize=17;fontFamily=Helvetica;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="100" width="1990" height="75" />
        </mxCell>
        <mxCell id="n681" value="Обоснования приведены дословно из раздела «Определение и оценка рисков для каждой категории данных». Они относятся к категории в целом; размещение под типом данных не означает отдельной оценки этого типа." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#172033;fontSize=17;fontFamily=Helvetica;spacing=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="190" width="1990" height="120" />
        </mxCell>
        <mxCell id="n682" value="Утечка&lt;br&gt;&lt;font color=&quot;#b91c1c&quot;&gt;&lt;b&gt;● Критический&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#8b5cf6;fontColor=#172033;fontSize=17;fontFamily=Helvetica;spacing=12;arcSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1090" y="360" width="300" height="100" />
