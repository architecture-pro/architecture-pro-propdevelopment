        <mxCell id="n500" value="PropDevelopment · Безопасность данных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172033;fontSize=17;fontFamily=Helvetica;spacing=12;arcSize=10;fontStyle=1;" vertex="1" parent="1">
